# Copy this file to `.env` and fill in real values.
# The real `.env` is gitignored — secrets never get committed.

# Base URL of your TrueNAS web UI (no trailing slash), e.g. https://192.168.1.50
# Must be https:// — TrueNAS 25.04+ auto-revokes API keys sent over plain HTTP.
TRUENAS_URL=

# API key from the TrueNAS web UI: user icon (top right) -> My API Keys -> Add.
# Copy the whole "<id>-<secret>" string — it is shown only once.
TRUENAS_API_KEY=

# Set to 1 if your NAS uses a self-signed certificate (the TrueNAS default).
# Leave empty to require a valid certificate.
TRUENAS_SKIP_TLS_VERIFY=

# Optional: the username the API key is linked to.
# Only needed on TrueNAS 27+ (where the older login method is removed).
TRUENAS_USERNAME=

# Optional, discouraged: set to 1 to allow plain http:// URLs despite the
# key-revocation risk described above.
TRUENAS_ALLOW_HTTP=

# --- Write support (all OFF by default — this server is read-only unless you opt in) ---

# Set to 1 to register the SAFE, reversible write tools (e.g. create snapshot,
# update dataset properties). Leave empty to keep the server read-only.
TRUENAS_ENABLE_WRITE=

# Set to 1 to register DESTRUCTIVE tools (delete/rollback/etc). These are
# additionally gated behind a human elicitation confirmation and fail closed if
# the client can't prompt. Leave empty (recommended) unless you deliberately
# want them. Requires TRUENAS_ENABLE_WRITE as well.
TRUENAS_ENABLE_DESTRUCTIVE=

# Test-safety guard: set to a disposable dataset (e.g. tank/mcp-test) to restrict
# ALL write tools to that dataset and its children — a mistake then cannot touch
# real data. Leave empty for normal use.
TRUENAS_TEST_DATASET=
