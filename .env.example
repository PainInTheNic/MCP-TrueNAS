# Copy this file to `.env` and fill in real values.
# The real `.env` is gitignored — secrets never get committed.

# Base URL of your TrueNAS web UI (no trailing slash), e.g. https://192.168.1.50
# Must be https:// — TrueNAS 25.04+ auto-revokes API keys sent over plain HTTP.
TRUENAS_URL=

# API key from the TrueNAS web UI: user icon (top right) -> My API Keys -> Add.
# Copy the whole "<id>-<secret>" string — it is shown only once.
TRUENAS_API_KEY=

# Set to 1 if your NAS uses a self-signed certificate (the TrueNAS default).
# Leave empty to require a valid certificate.
TRUENAS_SKIP_TLS_VERIFY=

# Optional: the username the API key is linked to.
# Only needed on TrueNAS 27+ (where the older login method is removed).
TRUENAS_USERNAME=

# Optional, discouraged: set to 1 to allow plain http:// URLs despite the
# key-revocation risk described above.
TRUENAS_ALLOW_HTTP=
